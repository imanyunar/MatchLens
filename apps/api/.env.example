# MatchLens Backend Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Database (Local PostgreSQL Docker by default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchlens
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=matchlens

# Supabase (Optional - Can be connected later)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Football Data Provider (football-data-org, api-football, or mock)
FOOTBALL_PROVIDER=football-data-org
FOOTBALL_API_KEY=your_football_data_org_api_key_here

# AI Provider (openrouter, gemini, or mock)
# For OpenRouter free model: nvidia/nemotron-3-ultra-550b-a55b:free
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
